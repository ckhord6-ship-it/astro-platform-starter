<!DOCTYPE html>
<html>
<head>
    <title>J03 DeepSeek Editor</title>
    <style>
        body {
            background: #0a0a12;
            color: #e2e8f0;
            font-family: 'Courier New', monospace;
            margin: 0;
            padding: 20px;
        }
        .editor {
            background: #16162c;
            border: 1px solid #3b82f6;
            border-radius: 8px;
            padding: 15px;
            height: 300px;
            overflow-y: auto;
        }
        .console {
            background: #000;
            padding: 10px;
            margin-top: 10px;
            border-radius: 4px;
            height: 100px;
            overflow-y: auto;
        }
        .prompt { color: #22c55e; }
        input {
            background: transparent;
            border: none;
            color: #fff;
            width: 80%;
            outline: none;
        }
    </style>
</head>
<body>
    <h2>J03 DeepSeek Editor</h2>
    <div class="editor" id="code-editor" contenteditable="true">
// J03 Developer Mode
function init() {
    console.log("J03 Ready");
    return "READY";
}
    </div>
    <div class="console">
        <div id="output"></div>
        <div class="console-input">
            <span class="prompt">J03 /> </span>
            <input id="command" onkeypress="if(event.key=='Enter')runCode()">
        </div>
    </div>

    <script>
        function runCode() {
            const code = document.getElementById('code-editor').innerText;
            const output = document.getElementById('output');
            output.innerHTML += `> ${code}\n`;
            output.innerHTML += "✓ Code executed in DeepSeek environment\n";
            document.getElementById('command').value = '';
            output.scrollTop = output.scrollHeight;
        }
    </script>
</body>
</html>
